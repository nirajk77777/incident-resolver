        "tickets_closed_carries_outcome_and_reply": {
          "name": "tickets_closed_carries_outcome_and_reply",
          "value": "(\"portal\".\"tickets\".\"status\" = 'closed') = (\"portal\".\"tickets\".\"outcome\" IS NOT NULL AND \"portal\".\"tickets\".\"reply\" IS NOT NULL)"
        },
        "tickets_resolved_only_when_closed": {
          "name": "tickets_resolved_only_when_closed",
          "value": "\"portal\".\"tickets\".\"resolved_by\" IS NULL OR \"portal\".\"tickets\".\"status\" = 'closed'"
        },
        "tickets_customer_has_reporter_email": {
          "name": "tickets_customer_has_reporter_email",
          "value": "\"portal\".\"tickets\".\"source\" <> 'customer' OR \"portal\".\"tickets\".\"reporter_email\" IS NOT NULL"
