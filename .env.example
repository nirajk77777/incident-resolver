# Infrastructure provided by docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/incident_resolver
# SELECT-only role used by mcp-database, created by `pnpm db:migrate`
SHOPLITE_READONLY_DATABASE_URL=postgres://shoplite_reader:shoplite_reader@localhost:5432/incident_resolver
# UPDATE/DELETE-only role portal-api runs an approved data fix as, created by `pnpm db:migrate`
SHOPLITE_WRITE_DATABASE_URL=postgres://shoplite_writer:shoplite_writer@localhost:5432/incident_resolver
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# Cohere, used by mcp-incidents for embeddings and rerank. Required to start the server or seed.
COHERE_API_KEY=

# Portal API. `fake` runs the scripted Resolver, which needs no model; `real` runs the agent
# from packages/agents and needs OPENAI_API_KEY, COHERE_API_KEY and a seeded, running ShopLite.
RESOLVER=fake
PORTAL_API_PORT=5000
PORTAL_API_HOST=127.0.0.1
FAKE_RESOLVER_STEP_DELAY_MS=400

# Models (defaults shown; see packages/shared/src/config.ts)
MODEL_RESOLVER=gpt-5.4
MODEL_TRIAGE=gpt-5.4-mini
MODEL_INVESTIGATOR=gpt-5.4-mini
MODEL_CODE_RCA=gpt-5.4
MODEL_FIX_SHIPPER=gpt-5.4-mini
MODEL_SENTINEL=gpt-5.4-nano
MODEL_EMBEDDINGS=embed-v4.0
MODEL_RERANK=rerank-v3.5

# Thresholds and caps
CONFIDENCE_THRESHOLD=0.6
SENTINEL_ERROR_RATIO=0.2
SENTINEL_WINDOW_SECONDS=60
SENTINEL_MIN_REQUESTS=5
SENTINEL_POLL_INTERVAL_MS=10000
RUN_TIMEOUT_MS=600000
DATA_FIX_ROW_CAP=100
QUERY_ROW_CAP=200
LOG_LINE_CAP=100
SHOPLITE_SERVICE_NAME=shoplite-api

# The Workspace: Code RCA works in a per-Ticket clone of the ShopLite repository (ADR-0001).
# WORKSPACES_DIR is read relative to this repository's root unless it is absolute, and
# WORKSPACE_COMMAND_TIMEOUT_MS caps the clone, the install, and each test run.
SHOPLITE_REPO_URL=https://github.com/nirajk77777/shoplite.git
WORKSPACES_DIR=workspaces
WORKSPACE_COMMAND_TIMEOUT_MS=300000

# GitHub, reached through the official remote MCP server. Set GITHUB_TOKEN to a personal
# access token scoped to the shoplite repository with contents and pull requests write; without
# it a run has no Fix Shipper and cannot open a pull request, and everything else still works.
# The toolsets header is what the server will expose at all, so it is the outer bound on the token.
GITHUB_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOOLSETS=repos,pull_requests
SHOPLITE_DEFAULT_BRANCH=main

KNOWLEDGE_SEARCH_CANDIDATES=20
KNOWLEDGE_SEARCH_TOP_K=3

# OpenAI, used by the agents. Required by `pnpm resolve`.
OPENAI_API_KEY=

# Langfuse Cloud, used by the agents for tracing. Optional: without both keys `pnpm resolve` runs untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# The prompt management label `pnpm prompts:sync` pushes to and the agents fetch by.
LANGFUSE_PROMPT_LABEL=production
